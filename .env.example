# Environment variables for the Astraea application.
# For local development, copy this file to .env and fill in the values.
# IMPORTANT: The .env file is git-ignored and should never be committed to version control.

# The full connection string for the database.
# For local Docker setup, this should point to the 'db' service.
DATABASE_URL="postgresql://astraea_user:your_secure_password@db/astraea_db"

# A strong, randomly generated secret key for signing JWTs.
# You can generate one with: openssl rand -hex 32
SECRET_KEY="your_super_secret_jwt_key"

# The algorithm to use for signing JWTs.
ALGORITHM="HS256"

# The expiration time for JWT access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Credentials for the PostgreSQL database container.
# These must match the values in docker-compose.yml.
POSTGRES_USER=astraea_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=astraea_db